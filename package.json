{
  "name": "@galaxypay/use-wallet-lute",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Lute wallet adapter for @txnlab/use-wallet",
  "author": "Andrew Funk",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalaxyPay/use-wallet-lute.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@txnlab/use-wallet": "^5.1.0",
    "algosdk": "^3.0.0"
  },
  "dependencies": {
    "@galaxypay/lute-connect": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@txnlab/use-wallet": "^5.1.0",
    "algosdk": "3.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "3.8.1",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "3.2.7"
  },
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  }
}
